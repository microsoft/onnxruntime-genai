{
  "name": "onnxruntime-genai-non-generative",
  "version": "0.18.0",
  "description": "Node.js bindings for ONNX Runtime GenAI non-generative package APIs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "build/Release/onnxruntime_genai_node.node",
    "build/Release/*.dll",
    "build/Release/*.dylib",
    "build/Release/*.so",
    "build/Release/*.so.*"
  ],
  "scripts": {
    "configure": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release",
    "build": "cmake --build build --config Release",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-api-headers": "^1.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
