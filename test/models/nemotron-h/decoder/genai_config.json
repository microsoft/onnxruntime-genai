{
    "model": {
        "type": "nemotron_h",
        "vocab_size": 16,
        "context_length": 64,
        "bos_token_id": 1,
        "eos_token_id": 15,
        "pad_token_id": 0,
        "decoder": {
            "filename": "model.onnx",
            "num_attention_heads": 2,
            "num_key_value_heads": 1,
            "head_size": 2,
            "hidden_size": 4,
            "num_hidden_layers": 4,
            "inputs": {
                "past_recurrent_names": "past_key_values.%d.ssm_state"
            },
            "outputs": {
                "hidden_states": "mtp_seed",
                "present_recurrent_names": "present.%d.ssm_state"
            }
        },
        "mtp": {
            "prefill_head": true,
            "filename": "../mtp/model.onnx",
            "num_hidden_layers": 1,
            "num_key_value_heads": 1,
            "head_size": 2,
            "main_hidden_states": "mtp_seed",
            "outputs": {
                "hidden_states": "mtp_hidden"
            }
        }
    },
    "search": {
        "past_present_share_buffer": false
    }
}
