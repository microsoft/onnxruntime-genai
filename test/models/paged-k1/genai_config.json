{
  "model": {
    "type": "llama",
    "context_length": 32,
    "vocab_size": 8,
    "pad_token_id": 0,
    "eos_token_id": 7,
    "decoder": {
      "filename": "model.onnx",
      "num_hidden_layers": 2,
      "num_attention_heads": 1,
      "num_key_value_heads": 1,
      "head_size": 64,
      "hidden_size": 64,
      "inputs": {
        "block_table": "block_table.%d"
      },
      "session_options": {
        "intra_op_num_threads": 1
      }
    }
  },
  "search": {
    "max_length": 32,
    "num_beams": 1,
    "do_sample": false
  },
  "engine": {
    "dynamic_batching": {
      "block_size": 16,
      "num_blocks": 4,
      "max_batch_size": 2,
      "max_scheduled_tokens": 64,
      "prefix_caching": false
    }
  }
}
