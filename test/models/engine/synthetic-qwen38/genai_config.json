{
  "model": {
    "type": "qwen38_flash_graph",
    "bos_token_id": 0,
    "eos_token_id": 127,
    "pad_token_id": 0,
    "vocab_size": 128,
    "context_length": 32,
    "decoder": {
      "filename": "decoder.onnx",
      "hidden_size": 1,
      "num_attention_heads": 1,
      "num_key_value_heads": 1,
      "head_size": 1,
      "num_hidden_layers": 1,
      "session_options": {
        "provider_options": [
          {
            "cuda": {
              "enable_cuda_graph": "1"
            }
          }
        ],
        "session.moe.offload.mode": "auto"
      }
    },
    "qwen38_graph": {
      "kv_capacity": 32,
      "ple_table": "ple.txt",
      "warmup": true,
      "head": {
        "filename_s1": "decoder.onnx"
      },
      "mtp": {
        "enabled": false,
        "prefill_head": false
      }
    }
  },
  "search": {
    "max_length": 32,
    "do_sample": false
  }
}
