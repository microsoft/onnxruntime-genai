{
  "processor": {
    "name": "lfm3_vl_image_processor",
    "transforms": [
      {
        "operation": {
          "name": "decode_image",
          "type": "DecodeImage",
          "attrs": {
            "color_space": "RGB"
          }
        }
      },
      {
        "operation": {
          "name": "resize",
          "type": "Resize",
          "attrs": {
            "interpolation": "CUBIC",
            "smart_resize": 1,
            "min_pixels": 65536,
            "max_pixels": 16777216,
            "patch_size": 16,
            "merge_size": 2
          }
        }
      },
      {
        "operation": {
          "name": "rescale",
          "type": "Rescale",
          "attrs": {
            "rescale_factor": 0.00392156862745098
          }
        }
      },
      {
        "operation": {
          "name": "normalize",
          "type": "Normalize",
          "attrs": {
            "mean": [
              0.5,
              0.5,
              0.5
            ],
            "std": [
              0.5,
              0.5,
              0.5
            ]
          }
        }
      },
      {
        "operation": {
          "name": "patch_image",
          "type": "PatchImage",
          "attrs": {
            "patch_size": 16,
            "temporal_patch_size": 2,
            "merge_size": 2
          }
        }
      }
    ]
  }
}
