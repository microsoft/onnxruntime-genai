{
  "_comment": "Each case references function names from test/tool-definitions/toolcalling.json. expected_function null means the model should answer directly and call nothing.",
  "cases": [
    {
      "name": "weather_basic",
      "tools": [
        "get_weather"
      ],
      "query": "What is the weather in Paris right now?",
      "expected_function": "get_weather",
      "expected_arguments": {
        "city": "Paris"
      },
      "tool_result": {
        "temperature_c": 11,
        "conditions": "light rain"
      },
      "expected_answer_contains": [
        "11",
        "rain"
      ]
    },
    {
      "name": "weather_enum_fahrenheit",
      "tools": [
        "get_weather"
      ],
      "query": "Weather in Boston in fahrenheit please.",
      "expected_function": "get_weather",
      "expected_arguments": {
        "city": "Boston",
        "unit": "fahrenheit"
      },
      "tool_result": {
        "temperature_f": 47,
        "conditions": "windy"
      },
      "expected_answer_contains": [
        "47",
        "wind"
      ]
    },
    {
      "name": "weather_enum_celsius",
      "tools": [
        "get_weather"
      ],
      "query": "Give me Tokyo's weather in celsius.",
      "expected_function": "get_weather",
      "expected_arguments": {
        "city": "Tokyo",
        "unit": "celsius"
      },
      "tool_result": {
        "temperature_c": 26,
        "conditions": "humid"
      },
      "expected_answer_contains": [
        "26",
        "humid"
      ]
    },
    {
      "name": "weather_multi_tool",
      "tools": "all",
      "query": "How cold is it in Oslo today?",
      "expected_function": "get_weather",
      "expected_arguments": {
        "city": "Oslo"
      },
      "tool_result": {
        "temperature_c": -7,
        "conditions": "snow"
      },
      "expected_answer_contains": [
        "-7",
        "snow"
      ]
    },
    {
      "name": "flight_all_required",
      "tools": [
        "search_flights"
      ],
      "query": "Find flights from SFO to JFK on 2026-10-01.",
      "expected_function": "search_flights",
      "expected_arguments": {
        "origin": "SFO",
        "destination": "JFK",
        "date": "2026-10-01"
      },
      "tool_result": {
        "flights": [
          {
            "number": "UA482",
            "depart": "07:15",
            "price_usd": 214
          }
        ]
      },
      "expected_answer_contains": [
        "UA482",
        "214"
      ]
    },
    {
      "name": "flight_integer_and_boolean",
      "tools": [
        "search_flights"
      ],
      "query": "Find nonstop flights from LAX to ORD on 2026-11-15 for 2 passengers.",
      "expected_function": "search_flights",
      "expected_arguments": {
        "origin": "LAX",
        "destination": "ORD",
        "date": "2026-11-15",
        "passengers": 2,
        "nonstop": true
      },
      "tool_result": {
        "flights": [
          {
            "number": "AA1901",
            "depart": "09:40",
            "price_usd": 378
          }
        ]
      },
      "expected_answer_contains": [
        "AA1901",
        "378"
      ]
    },
    {
      "name": "flight_multi_tool",
      "tools": "all",
      "query": "Search flights CDG to LHR on 2026-12-24.",
      "expected_function": "search_flights",
      "expected_arguments": {
        "origin": "CDG",
        "destination": "LHR",
        "date": "2026-12-24"
      },
      "tool_result": {
        "flights": [
          {
            "number": "BA306",
            "depart": "18:05",
            "price_usd": 152
          }
        ]
      },
      "expected_answer_contains": [
        "BA306",
        "152"
      ]
    },
    {
      "name": "order_array",
